---
import Layout from '../layouts/Layout.astro';

const models = [
  {
    id: "el-314",
    name: "EVUUS EL-314 / EL-314P",
    desc: "Laptop 14.1\" WXGA LED, Procesador Intel® Celeron® / Core™ i3, Gráficos Intel HD, 3x USB 2.0, HDMI, VGA.",
    osList: ["Windows 7 (32-bit)", "Windows 7 (64-bit)", "Windows 8.1", "Windows 10"],
    drivers: [
      { name: "Intel® Chipset Device Software", version: "9.2.0.1030", size: "3.2 MB", type: "Chipset", date: "Certificado", req: "Solicitud Driver Chipset EL-314" },
      { name: "Intel® HD Graphics Video Driver", version: "8.15.10.2622", size: "58.4 MB", type: "Video", date: "Certificado", req: "Solicitud Driver Video EL-314" },
      { name: "Realtek High Definition Audio Driver", version: "6.0.1.6526", size: "72.1 MB", type: "Audio", date: "Certificado", req: "Solicitud Driver Audio EL-314" },
      { name: "Realtek PCIe Fast Ethernet LAN Driver", version: "7.048", size: "6.8 MB", type: "Red LAN", date: "Certificado", req: "Solicitud Driver LAN EL-314" },
      { name: "Realtek Wireless 802.11n WLAN Driver", version: "2013.2.0123", size: "19.5 MB", type: "Wi-Fi", date: "Certificado", req: "Solicitud Driver WiFi EL-314" },
      { name: "Synaptics Multi-Gesture Touchpad Driver", version: "15.3.29.0", size: "42.0 MB", type: "Touchpad", date: "Certificado", req: "Solicitud Driver Touchpad EL-314" },
      { name: "Realtek Multi-Card Reader Driver", version: "6.1.7600", size: "9.4 MB", type: "Card Reader", date: "Certificado", req: "Solicitud Driver Card Reader EL-314" },
    ]
  },
  {
    id: "el-514s",
    name: "EVUUS EL-514/S High Performance",
    desc: "Laptop 14.1\" Ultraliviana, Procesador Intel® Core™ i5, Gráficos Intel HD 3000/4000, Puerto HDMI 1.4, Wi-Fi b/g/n, Bluetooth 3.0.",
    osList: ["Windows 7 (64-bit)", "Windows 8.1 (64-bit)", "Windows 10 (64-bit)"],
    drivers: [
      { name: "Intel® Series 6/7 Express Chipset", version: "9.3.0.1026", size: "4.1 MB", type: "Chipset", date: "Certificado", req: "Solicitud Driver Chipset EL-514S" },
      { name: "Intel® HD Graphics 3000/4000 Driver", version: "9.17.10.4229", size: "112.0 MB", type: "Video", date: "Certificado", req: "Solicitud Driver Video EL-514S" },
      { name: "Intel® Management Engine Interface (MEI)", version: "8.1.0.1263", size: "54.2 MB", type: "Sistema", date: "Certificado", req: "Solicitud Driver ME EL-514S" },
      { name: "Realtek ALC269 High Definition Audio", version: "6.0.1.7023", size: "84.3 MB", type: "Audio", date: "Certificado", req: "Solicitud Driver Audio EL-514S" },
      { name: "Gigabit Ethernet Controller Realtek", version: "7.067", size: "7.5 MB", type: "Red LAN", date: "Certificado", req: "Solicitud Driver LAN EL-514S" },
      { name: "Combo Wi-Fi 802.11n + Bluetooth 3.0 Driver", version: "1.0.0.8", size: "38.6 MB", type: "Wi-Fi & BT", date: "Certificado", req: "Solicitud Driver BT EL-514S" },
    ]
  }
];
---

<Layout
  title="Drivers y Controladores Oficiales"
  description="Centro oficial de descargas de drivers y controladores para laptops EVUUS EL-314, EL-314/P y EL-514/S. Soporte técnico garantizado."
  currentPath="/drivers/"
>
  <div class="drivers-hero">
    <div class="container">
      <div class="hero-badge">Centro de Descargas Oficial</div>
      <h1 class="hero-title">Drivers & Controladores</h1>
      <p class="hero-desc">
        Descargue los controladores certificados de hardware para mantener el máximo rendimiento, estabilidad y compatibilidad de su equipo portátil EVUUS.
      </p>
    </div>
  </div>

  <section class="section drivers-content">
    <div class="container">
      <div class="instructions-card">
        <div class="inst-icon">💡</div>
        <div class="inst-text">
          <h4>Recomendaciones previas a la instalación</h4>
          <p>
            Para una óptima instalación en sistemas operativos nuevos o formateados, recomendamos instalar primero el controlador de <strong>Chipset Intel®</strong>, seguido del controlador de <strong>Gráficos (Video)</strong>, <strong>Audio</strong> y finalmente los adaptadores de <strong>Red (LAN/Wi-Fi)</strong>.
          </p>
        </div>
      </div>

      {models.map((m) => (
        <div class="model-driver-block" id={m.id}>
          <div class="model-header">
            <div>
              <span class="badge badge-accent">Familia de Hardware</span>
              <h2 class="model-title">{m.name}</h2>
              <p class="model-desc">{m.desc}</p>
            </div>
            <div class="os-support">
              <span class="os-label">Sistemas Operativos Soportados:</span>
              <div class="os-tags">
                {m.osList.map((os) => (
                  <span class="os-tag">{os}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="drivers-table-wrapper">
            <table class="drivers-table">
              <thead>
                <tr>
                  <th>Componente / Controlador</th>
                  <th>Tipo</th>
                  <th>Versión</th>
                  <th>Tamaño</th>
                  <th>Estado</th>
                  <th class="text-right">Acción</th>
                </tr>
              </thead>
              <tbody>
                {m.drivers.map((d) => (
                  <tr>
                    <td>
                      <div class="driver-name-col">
                        <span class="comp-icon">💾</span>
                        <strong>{d.name}</strong>
                      </div>
                    </td>
                    <td><span class="type-badge">{d.type}</span></td>
                    <td class="version-col">{d.version}</td>
                    <td>{d.size}</td>
                    <td><span class="status-pill">Verificado</span></td>
                    <td class="text-right">
                      <a
                        href={`mailto:soporte@evuus.com?subject=${encodeURIComponent(d.req)}&body=${encodeURIComponent("Hola soporte EVUUS, solicito el paquete de instalador directo para: " + d.name + " (" + m.name + "). Mi número de serial de equipo es: ")}`}
                        class="btn-dl"
                      >
                        Descargar / Solicitar Driver
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}

      <div class="bios-notice-box">
        <div class="notice-col">
          <h3>¿Necesita Asistencia Especial o Disco de Restauración?</h3>
          <p>
            Si requiere una imagen ISO del disco de fábrica de EVUUS con todos los controladores preinstalados o necesita soporte para actualización de BIOS, comuníquese con el departamento de ingeniería:
          </p>
        </div>
        <div class="notice-action">
          <a href="mailto:soporte@evuus.com?subject=Solicitud ISO Restauracion Fabrica EVUUS" class="btn btn-primary">
            Solicitar ISO de Fábrica
          </a>
          <a href="/soporte#centros" class="btn btn-outline-dark">
            Centros de Servicio
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .drivers-hero {
    background: linear-gradient(135deg, var(--dark) 0%, #004d80 100%);
    color: var(--white);
    padding: 5rem 0 3.5rem;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: rgba(0, 168, 232, 0.2);
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 900;
    line-height: 1.15;
    margin-bottom: 1rem;
  }

  .hero-desc {
    font-size: 1.15rem;
    color: #cbd5e1;
    max-width: 680px;
    line-height: 1.6;
  }

  .instructions-card {
    background: #eff6ff;
    border: 1px solid #bfdbfe;
    border-radius: 12px;
    padding: 1.5rem 2rem;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    margin-bottom: 3.5rem;
  }

  .inst-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .inst-text h4 {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 0.35rem;
  }

  .inst-text p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: #1e3a8a;
    margin: 0;
  }

  .model-driver-block {
    background: var(--white);
    border-radius: 16px;
    border: 1px solid var(--border);
    padding: 2.5rem;
    margin-bottom: 3.5rem;
    box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);
  }

  .model-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    border-bottom: 2px solid var(--border);
    padding-bottom: 1.75rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .model-title {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--dark);
    margin: 0.5rem 0 0.35rem;
  }

  .model-desc {
    font-size: 0.95rem;
    color: var(--gray);
    max-width: 650px;
    margin: 0;
  }

  .os-support {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
  }

  .os-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #64748b;
  }

  .os-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .os-tag {
    background: var(--light);
    border: 1px solid var(--border);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    color: var(--dark);
  }

  .drivers-table-wrapper {
    overflow-x: auto;
  }

  .drivers-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }

  .drivers-table th {
    text-align: left;
    padding: 0.85rem 1rem;
    background: var(--light);
    color: var(--dark);
    font-weight: 800;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 2px solid var(--border);
  }

  .drivers-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--border);
    vertical-align: middle;
  }

  .driver-name-col {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .comp-icon {
    font-size: 1.25rem;
  }

  .type-badge {
    background: rgba(0, 168, 232, 0.12);
    color: #0077a8;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
  }

  .version-col {
    font-family: monospace;
    font-size: 0.85rem;
    color: #475569;
  }

  .status-pill {
    background: #dcfce7;
    color: #166534;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
  }

  .btn-dl {
    display: inline-block;
    background: var(--primary);
    color: var(--white);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
    white-space: nowrap;
  }

  .btn-dl:hover {
    background: var(--accent);
    color: var(--white);
    transform: translateY(-1px);
  }

  .text-right {
    text-align: right;
  }

  .bios-notice-box {
    background: linear-gradient(135deg, var(--light) 0%, #e2e8f0 100%);
    border-radius: 16px;
    padding: 3rem;
    border: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .notice-col h3 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  .notice-col p {
    font-size: 0.95rem;
    color: var(--gray);
    max-width: 620px;
    margin: 0;
  }

  .notice-action {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-outline-dark {
    background: transparent;
    color: var(--dark);
    border: 1px solid var(--dark);
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-outline-dark:hover {
    background: var(--dark);
    color: var(--white);
  }
</style>