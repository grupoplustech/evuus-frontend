---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = 'EVUUS COMPUTERS & ELECTRONICS - Portátiles, All in One y soluciones de computación corporativa y para el hogar. Tecnología a su alcance.',
  currentPath = '/',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | EVUUS Electronics</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="EVUUS, evuus electronics, laptops evuus, EL-314, EL-514, computadoras, venezuela, tecnologia a su alcance, caracas, soporte evuus" />
    <meta property="og:title" content={`${title} | EVUUS Electronics`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo.png" />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
